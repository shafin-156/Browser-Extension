{
  "manifest_version": 3,
  "name": "Enable Plus",
  "version": "3.4",
  "description": "Fully automatic: Enable copy and removes writing protection from all elements on every page.",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "enableplus@supercode.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}